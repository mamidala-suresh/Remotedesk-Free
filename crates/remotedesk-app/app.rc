#define RT_MANIFEST 24
#define CREATEPROCESS_MANIFEST_RESOURCE_ID 1

CREATEPROCESS_MANIFEST_RESOURCE_ID RT_MANIFEST "app.manifest"
1 ICON "icon.ico"

1 VERSIONINFO
FILEVERSION 1,1,0,1
PRODUCTVERSION 1,1,0,1
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS 0x40004L
FILETYPE 0x1L
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "Freeware | Suresh Mamidala\0"
            VALUE "FileDescription", "RemoteDesk Free Windows Enterprise Remote Desktop\0"
            VALUE "FileVersion", "1.1.0.1\0"
            VALUE "InternalName", "RemoteDesk-Free\0"
            VALUE "LegalCopyright", "Copyright (C) 2026 Suresh Mamidala\0"
            VALUE "OriginalFilename", "RemoteDesk-Free.exe\0"
            VALUE "ProductName", "RemoteDesk Free\0"
            VALUE "ProductVersion", "1.1.0.1\0"
            VALUE "Comments", "Safe and verified freeware remote desktop solution\0"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
