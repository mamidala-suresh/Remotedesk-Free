<Window x:Class="RemoteDesk.Wpf.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:RemoteDesk.Wpf.ViewModels"
        xmlns:views="clr-namespace:RemoteDesk.Wpf.Views"
        mc:Ignorable="d"
        Title="RemoteDesk Free" Height="780" Width="1200"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDarkBrush}"
        Foreground="{StaticResource TextPrimaryBrush}"
        WindowStyle="SingleBorderWindow">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- Left Modern Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource SurfaceDarkBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,1,0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Brand Header -->
                <StackPanel Grid.Row="0" Margin="20,24,20,24" Orientation="Horizontal">
                    <Border Width="36" Height="36" Background="{StaticResource PrimaryBlueBrush}" CornerRadius="8" Margin="0,0,12,0">
                        <TextBlock Text="⚡" FontSize="20" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock Text="RemoteDesk" FontSize="16" FontWeight="Bold" Foreground="White" />
                        <TextBlock Text="FREE ENTERPRISE" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource SuccessGreenBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Navigation Menu -->
                <StackPanel Grid.Row="1" Margin="12,0">
                    <Button Content="🏠  Dashboard" Style="{StaticResource FluentSecondaryButton}" Background="#2563EB20" BorderBrush="{StaticResource PrimaryBlueBrush}" Foreground="White" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" />
                    <Button Content="📖  Address Book &amp; Devices" Style="{StaticResource FluentSecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" />
                    <Button Content="🕒  Recent Sessions" Style="{StaticResource FluentSecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" />
                    <Button Content="⚙️  Engine Settings" Style="{StaticResource FluentSecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" />
                    <Button Content="🛡️  Security &amp; Encryption" Style="{StaticResource FluentSecondaryButton}" HorizontalContentAlignment="Left" Margin="0,0,0,8" Padding="14,10" />
                </StackPanel>

                <!-- User & Version Info Footer -->
                <Border Grid.Row="2" Padding="16" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,1,0,0">
                    <StackPanel>
                        <TextBlock Text="Suresh Mamidala" FontWeight="SemiBold" FontSize="12" Foreground="White" />
                        <TextBlock Text="v1.1.0.1 • DXGI &amp; GPU H.264" FontSize="11" Foreground="{StaticResource TextSecondaryBrush}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main Content Area -->
        <Grid Grid.Column="1">
            <!-- Normal Dashboard (when not in session) -->
            <Grid Visibility="{Binding IsInSession, Converter={StaticResource BooleanToVisibilityConverter}, ConverterParameter=Inverse}">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Status Banner -->
                <Border Grid.Row="0" Background="#1E293B80" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="0,0,0,1" Padding="24,14">
                    <Grid>
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <Ellipse Width="10" Height="10" Fill="{StaticResource SuccessGreenBrush}" Margin="0,0,10,0" />
                            <TextBlock Text="{Binding StatusMessage}" FontSize="13" FontWeight="Medium" Foreground="{StaticResource TextSecondaryBrush}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Dashboard Cards -->
                <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="32">
                    <StackPanel MaxWidth="900" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,32">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Your Desk Card -->
                            <Border Grid.Column="0" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="YOUR DESK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="Your Device ID" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Border Background="#0F172A" CornerRadius="8" Padding="16,10" Margin="0,0,0,16">
                                        <TextBlock Text="{Binding MyDeviceId}" FontSize="24" FontWeight="Bold" Foreground="{StaticResource PrimaryBlueBrush}" LetterSpacing="2" />
                                    </Border>
                                    <TextBlock Text="One-Time Security PIN" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <Border Background="#0F172A" CornerRadius="8" Padding="16,10">
                                        <TextBlock Text="{Binding MyPin}" FontSize="20" FontWeight="Bold" Foreground="#38BDF8" LetterSpacing="2" />
                                    </Border>
                                    <TextBlock Text="Allow trusted remote partners to view and control your desktop." FontSize="11" Foreground="{StaticResource TextMutedBrush}" Margin="0,16,0,0" TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!-- Control Remote Desk Card -->
                            <Border Grid.Column="2" Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                                <StackPanel>
                                    <TextBlock Text="CONTROL REMOTE DESK" FontSize="11" FontWeight="Bold" Foreground="{StaticResource TextMutedBrush}" Margin="0,0,0,12" />
                                    <TextBlock Text="Remote Device ID" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TargetDeviceId, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,14" />

                                    <TextBlock Text="Remote PIN / Unattended Password" FontSize="13" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding TargetPin, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FluentTextBox}" Margin="0,0,0,20" />

                                    <Button Content="Connect Now" Style="{StaticResource FluentPrimaryButton}" Click="OnConnectClick" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!-- Address Book & Recent Connections -->
                        <Border Background="{StaticResource SurfaceCardBrush}" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="12" Padding="24">
                            <StackPanel>
                                <TextBlock Text="RECENT SESSIONS &amp; SAVED DEVICES" FontSize="13" FontWeight="Bold" Foreground="{StaticResource TextSecondaryBrush}" Margin="0,0,0,16" />
                                <ItemsControl ItemsSource="{Binding RecentDevices}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#0F172A" BorderBrush="{StaticResource BorderDarkBrush}" BorderThickness="1" CornerRadius="8" Padding="16,12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" Text="💻" FontSize="20" Margin="0,0,16,0" VerticalAlignment="Center" />
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                        <TextBlock Text="{Binding Alias}" FontWeight="SemiBold" FontSize="13" Foreground="White" />
                                                        <TextBlock Text="{Binding DeviceId}" FontSize="12" Foreground="{StaticResource TextMutedBrush}" />
                                                    </StackPanel>
                                                    <Button Grid.Column="2" Content="Connect" Style="{StaticResource FluentSecondaryButton}" Click="OnRecentConnectClick" />
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- Active Hardware Session Viewport -->
            <Grid Visibility="{Binding IsInSession, Converter={StaticResource BooleanToVisibilityConverter}}">
                <views:RemoteViewControl />
            </Grid>
        </Grid>
    </Grid>
</Window>
